{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Planton design tokens — DTCG format. Single source of truth. Edit values here only; do not hand-edit src/index.css or src/generated/tokens.tsx. Colors authored as hex; build-tokens.mjs converts to H S% L% for the web theme.",
  "color": {
    "$type": "color",
    "light": {
      "background":          { "$value": "#F8FAFC", "$description": "Fundo geral — separa cards sem sombras." },
      "foreground":          { "$value": "#101828", "$description": "Texto principal. Contraste ~16,9:1 sobre surface." },
      "border":              { "$value": "#D0D5DD", "$description": "Separa cards, inputs e grupos sem peso visual." },
      "card":                { "$value": "#FFFFFF", "$description": "Surface de cards e áreas de conteúdo." },
      "cardForeground":      { "$value": "#101828" },
      "popover":             { "$value": "#FFFFFF" },
      "popoverForeground":   { "$value": "#101828" },
      "primary":             { "$value": "#155EEF", "$description": "Ação e navegação: Tenho interesse, Publicar plantão, estados selecionados. Nunca ocupa o fundo inteiro." },
      "primaryForeground":   { "$value": "#FFFFFF" },
      "secondary":           { "$value": "#EFF4FF", "$description": "Superfície secundária azul claro — tint do primary." },
      "secondaryForeground": { "$value": "#155EEF" },
      "muted":               { "$value": "#F1F5F9", "$description": "Superfície atenuada para separação sutil." },
      "mutedForeground":     { "$value": "#475467", "$description": "Texto auxiliar, distâncias, legendas. Contraste ~7,7:1 sobre surface." },
      "accent":              { "$value": "#0E9384", "$description": "Disponibilidade, confirmação e estados positivos. Não compete com o CTA principal." },
      "accentForeground":    { "$value": "#FFFFFF" },
      "destructive":         { "$value": "#D92D20", "$description": "Erro, cancelamento e ações destrutivas." },
      "destructiveForeground": { "$value": "#FFFFFF" },
      "input":               { "$value": "#D0D5DD" },
      "ring":                { "$value": "#155EEF" },
      "chart1":              { "$value": "#155EEF", "$description": "Primary blue — CTA e ações." },
      "chart2":              { "$value": "#0E9384", "$description": "Teal — disponibilidade e confirmação." },
      "chart3":              { "$value": "#DC6803", "$description": "Warning — urgência, plantão próximo de começar." },
      "chart4":              { "$value": "#7C3AED", "$description": "Violeta — série de dados adicional." },
      "chart5":              { "$value": "#0EA5E9", "$description": "Azul céu — série de dados adicional." },
      "sidebar":             { "$value": "#FFFFFF" },
      "sidebarForeground":   { "$value": "#101828" },
      "sidebarBorder":       { "$value": "#D0D5DD" },
      "sidebarPrimary":      { "$value": "#155EEF" },
      "sidebarPrimaryForeground": { "$value": "#FFFFFF" },
      "sidebarAccent":       { "$value": "#EFF4FF" },
      "sidebarAccentForeground": { "$value": "#155EEF" },
      "sidebarRing":         { "$value": "#155EEF" }
    },
    "dark": {
      "background":          { "$value": "#0D1220", "$description": "Fundo escuro — navy profundo." },
      "foreground":          { "$value": "#F1F5F9" },
      "border":              { "$value": "#2D3F5A" },
      "card":                { "$value": "#152035" },
      "cardForeground":      { "$value": "#F1F5F9" },
      "popover":             { "$value": "#152035" },
      "popoverForeground":   { "$value": "#F1F5F9" },
      "primary":             { "$value": "#3B82F6", "$description": "Azul mais claro para legibilidade no dark." },
      "primaryForeground":   { "$value": "#FFFFFF" },
      "secondary":           { "$value": "#1A2840" },
      "secondaryForeground": { "$value": "#93C5FD" },
      "muted":               { "$value": "#1A2840" },
      "mutedForeground":     { "$value": "#94A3B8" },
      "accent":              { "$value": "#14B8A6", "$description": "Teal mais claro para dark mode." },
      "accentForeground":    { "$value": "#FFFFFF" },
      "destructive":         { "$value": "#F04438" },
      "destructiveForeground": { "$value": "#FFFFFF" },
      "input":               { "$value": "#2D3F5A" },
      "ring":                { "$value": "#3B82F6" },
      "chart1":              { "$value": "#3B82F6" },
      "chart2":              { "$value": "#2DD4BF" },
      "chart3":              { "$value": "#F59E0B" },
      "chart4":              { "$value": "#A78BFA" },
      "chart5":              { "$value": "#38BDF8" },
      "sidebar":             { "$value": "#0D1220" },
      "sidebarForeground":   { "$value": "#F1F5F9" },
      "sidebarBorder":       { "$value": "#2D3F5A" },
      "sidebarPrimary":      { "$value": "#3B82F6" },
      "sidebarPrimaryForeground": { "$value": "#FFFFFF" },
      "sidebarAccent":       { "$value": "#1A2840" },
      "sidebarAccentForeground": { "$value": "#93C5FD" },
      "sidebarRing":         { "$value": "#3B82F6" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans":  { "$value": ["Inter", "sans-serif"], "$description": "Único tipo do produto. Pesos 400/600/700 conforme escala." },
      "serif": { "$value": ["Georgia", "serif"] },
      "mono":  { "$value": ["Menlo", "monospace"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.875rem",
      "$description": "Base 14px → sm=10px (inputs), md=12px (cards/botões), lg=14px, xl=18px, full=9999px para status e filtros."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Escala fixa 4/8/16/24/40 px derivada deste passo base."
    }
  }
}
